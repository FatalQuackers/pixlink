<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Pixlink.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pixlink"
    xmlns:models="using:Pixlink.Models"
    Title="Tethr Link">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <!-- One phone notification. Expanded cards show the whole message, the chat, the app's buttons and a reply box. -->
            <DataTemplate x:Key="NotifTemplate" x:DataType="models:PhoneNotification">
                <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,8">
                    <Grid ColumnSpacing="10" RowSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="{x:Bind AppName}" /> · <Run Text="{x:Bind TimeText}" />
                        </TextBlock>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                            <Button Style="{StaticResource SubtleButtonStyle}" Padding="6,4" Click="OnPinNotification" Tag="{x:Bind}" ToolTipService.ToolTip="Pin to Home">
                                <FontIcon Glyph="&#xE718;" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource SubtleButtonStyle}" Padding="6,4" Click="OnToggleExpand" Tag="{x:Bind}"
                                    Visibility="{x:Bind HasMore}" ToolTipService.ToolTip="Show more">
                                <FontIcon Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource SubtleButtonStyle}" Padding="6,4" Click="OnDismiss" Tag="{x:Bind}" ToolTipService.ToolTip="Dismiss on phone">
                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                            </Button>
                        </StackPanel>

                        <!-- Tapping the title or text expands the card -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Background="Transparent" Tapped="OnCardTapped" Tag="{x:Bind}" Margin="0,4,0,0">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="{x:Bind TitleLines, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <local:LinkTextBlock Text="{x:Bind Text}" MaxLines="{x:Bind TextLines, Mode=OneWay}" Visibility="{x:Bind ShowSingleText, Mode=OneWay}" />
                        </StackPanel>

                        <!-- Expanded: conversation, buttons, reply -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Spacing="8" Margin="0,8,0,0" Visibility="{x:Bind IsExpanded, Mode=OneWay}">
                            <ItemsRepeater ItemsSource="{x:Bind History}" Visibility="{x:Bind HasHistory, Mode=OneWay}">
                                <ItemsRepeater.Layout><StackLayout Spacing="4" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:ChatBubble">
                                        <Border HorizontalAlignment="{x:Bind Align}" MaxWidth="280" CornerRadius="12" Padding="10,6" Background="{x:Bind BubbleBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Sender}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ShowSender}" />
                                                <local:LinkTextBlock Text="{x:Bind Text}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!-- App buttons wrap onto new lines instead of running off the card -->
                            <ItemsRepeater ItemsSource="{x:Bind AllButtons}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="120" MinItemHeight="32" MinColumnSpacing="6" MinRowSpacing="6" ItemsStretch="Fill" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:NotifAction">
                                        <Button Click="OnNotifAction" Tag="{x:Bind}" Padding="10,4" HorizontalAlignment="Stretch" ToolTipService.ToolTip="{x:Bind Title}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" />
                                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <Grid ColumnSpacing="6" Visibility="{x:Bind CanReply}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox PlaceholderText="Reply" TextWrapping="Wrap" AcceptsReturn="False" Text="{x:Bind ReplyDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="OnNotifReplyKeyDown" Tag="{x:Bind}" />
                                <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnNotifReply" Tag="{x:Bind}" ToolTipService.ToolTip="Send">
                                    <FontIcon Glyph="&#xE724;" FontSize="14" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar with the connection status, readable at a glance -->
        <Grid x:Name="AppTitleBar" Padding="16,0,150,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="Assets/Pixlink.png" Width="18" Height="18" />
                <TextBlock Text="Tethr Link" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <Border x:Name="StatusPill" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="110,0,0,0"
                CornerRadius="12" Padding="10,4" Background="{ThemeResource ControlFillColorDefaultBrush}"
                Visibility="{x:Bind local:Ui.Visible(Session.IsPaired), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Grid Width="12" Height="12" VerticalAlignment="Center">
                    <Ellipse Fill="{x:Bind Session.StatusBrush, Mode=OneWay}" Width="10" Height="10" />
                    <ProgressRing IsActive="{x:Bind Session.StatusBusy, Mode=OneWay}" Width="12" Height="12" MinWidth="12" MinHeight="12" Foreground="{x:Bind Session.StatusBrush, Mode=OneWay}" />
                </Grid>
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center">
                    <Run Text="{x:Bind Session.StatusText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{x:Bind Session.PhoneName, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Paired layout: phone panel + tabs -->
        <Grid Grid.Row="1" Visibility="{x:Bind local:Ui.Visible(Session.IsPaired), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: phone panel -->
            <Grid Padding="16,4,8,16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Phone header: a coloured edge shows the connection state from across the room -->
                <Border Style="{StaticResource PanelCardStyle}" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{x:Bind Session.StatusBrush, Mode=OneWay}" CornerRadius="8,0,0,8" />
                        <Grid Grid.Column="1" Padding="14" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="72" CornerRadius="8" BorderThickness="2" BorderBrush="{ThemeResource TextFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xE8EA;" FontSize="18" Foreground="{StaticResource PixlinkBlueBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{x:Bind Session.PhoneName, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <TextBlock Text="{x:Bind Session.StatusText, Mode=OneWay}" Foreground="{x:Bind Session.StatusBrush, Mode=OneWay}" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind local:Ui.VisibleIfText(Session.BatteryText), Mode=OneWay}">
                                        <FontIcon Glyph="{x:Bind Session.BatteryGlyph, Mode=OneWay}" FontSize="14" />
                                        <TextBlock Text="{x:Bind Session.BatteryText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Quick actions (choose which in Settings → Quick actions) -->
                <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind Session.QuickActions}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MaximumRowsOrColumns="3" MinItemWidth="100" MinItemHeight="64" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:QuickActionItem">
                            <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="OnQuickAction" Tag="{x:Bind}"
                                    Background="{x:Bind Background, Mode=OneWay}" Foreground="{x:Bind Foreground, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind Tip}">
                                <StackPanel Spacing="4">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" />
                                    <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Now playing on the phone -->
                <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}" Visibility="{x:Bind Session.MediaActive, Mode=OneWay}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource PixlinkBlueBrush}">
                            <FontIcon Glyph="&#xE8D6;" FontSize="18" Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Session.MediaTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                <Run Text="{x:Bind Session.MediaArtist, Mode=OneWay}" /><Run Text="  " /><Run Text="{x:Bind Session.MediaApp, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                            <Button Style="{StaticResource SubtleButtonStyle}" Click="OnMediaPrevious" ToolTipService.ToolTip="Previous"><FontIcon Glyph="&#xE892;" FontSize="14" /></Button>
                            <Button Style="{StaticResource SubtleButtonStyle}" Click="OnMediaToggle" ToolTipService.ToolTip="Play or pause"><FontIcon Glyph="{x:Bind Session.PlayPauseGlyph, Mode=OneWay}" FontSize="16" /></Button>
                            <Button Style="{StaticResource SubtleButtonStyle}" Click="OnMediaNext" ToolTipService.ToolTip="Next"><FontIcon Glyph="&#xE893;" FontSize="14" /></Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Hotspot / quick action messages -->
                <InfoBar x:Name="HotspotBar" Grid.Row="3" IsOpen="False" IsClosable="True" Margin="0" />

                <!-- Notifications header -->
                <Grid Grid.Row="4" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Notifications" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <ToggleButton x:Name="GroupToggle" Grid.Column="1" Style="{StaticResource SubtleToggleStyle}" Click="OnGroupToggle" ToolTipService.ToolTip="Group by app">
                        <FontIcon Glyph="&#xF168;" FontSize="14" />
                    </ToggleButton>
                    <HyperlinkButton Grid.Column="2" Content="Clear all" Click="OnClearAll" />
                </Grid>

                <!-- Notifications: a ScrollViewer + ItemsRepeater re-measures cards when they expand, so nothing gets cut off -->
                <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <Grid>
                        <ItemsRepeater x:Name="FlatList" ItemsSource="{x:Bind Session.Notifications}" ItemTemplate="{StaticResource NotifTemplate}" />
                        <ItemsRepeater x:Name="GroupedList" ItemsSource="{x:Bind Session.NotificationGroups}" Visibility="Collapsed">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:NotificationGroup">
                                    <StackPanel Margin="0,0,0,8">
                                        <Button Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Click="OnToggleGroup" Tag="{x:Bind}" Padding="8,6" Margin="0,0,0,6">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{x:Bind Icon}" Width="20" Height="20" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                                    <Run Text="{x:Bind AppName}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{x:Bind CountText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </TextBlock>
                                                <FontIcon Grid.Column="2" Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="11" />
                                            </Grid>
                                        </Button>
                                        <ItemsRepeater ItemsSource="{x:Bind Items}" ItemTemplate="{StaticResource NotifTemplate}" Visibility="{x:Bind IsExpanded, Mode=OneWay}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <StackPanel x:Name="NoNotifications" Spacing="6" Margin="0,24,0,0" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xEA8F;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="NoNotificationsText" Text="You're all caught up" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Right: tabs -->
            <Grid Grid.Column="1" Margin="8,0,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar x:Name="UpdateBar" IsOpen="False" Severity="Informational" Title="Update available" Margin="0,0,0,8">
                    <InfoBar.ActionButton>
                        <Button x:Name="UpdateNowButton" Content="Update now" Click="OnUpdateNow" Style="{StaticResource AccentButtonStyle}" />
                    </InfoBar.ActionButton>
                    <InfoBar.Content>
                        <HyperlinkButton Content="What's new" Click="OnWhatsNew" Margin="0,0,0,8" />
                    </InfoBar.Content>
                </InfoBar>
                <InfoBar x:Name="ConnectionBar" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="0,0,0,8" />
                <Grid Grid.Row="2">
                    <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged">
                        <SelectorBarItem Text="Home" Tag="Home" IsSelected="True">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE80F;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="MessagesTab" Text="Messages" Tag="Messages">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE8BD;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="CallsTab" Text="Calls" Tag="Calls">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE717;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem Text="Photos" Tag="Photos">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xEB9F;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="FilesTab" Text="Files" Tag="Files">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE8B7;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem Text="Screen" Tag="Screen">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE7F4;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem Text="Settings" Tag="Settings">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE713;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                    </SelectorBar>
                </Grid>
                <Border Grid.Row="3" Style="{StaticResource PanelCardStyle}" Padding="0" Margin="0,8,0,0">
                    <Frame x:Name="ContentFrame" />
                </Border>
            </Grid>
        </Grid>

        <!-- First-run setup after linking -->
        <Frame x:Name="SetupFrame" Grid.Row="1" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />

        <!-- "You're linked!" moment right after pairing -->
        <Grid x:Name="SuccessOverlay" Grid.Row="1" Visibility="Collapsed" Background="{ThemeResource SmokeFillColorDefaultBrush}">
            <Grid.Resources>
                <Storyboard x:Key="SuccessIn">
                    <DoubleAnimation Storyboard.TargetName="SuccessOverlay" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                    <DoubleAnimation Storyboard.TargetName="SuccessScale" Storyboard.TargetProperty="ScaleX" From="0.6" To="1" Duration="0:0:0.45">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="SuccessScale" Storyboard.TargetProperty="ScaleY" From="0.6" To="1" Duration="0:0:0.45">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="SuccessCheck" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.25" Duration="0:0:0.3" />
                </Storyboard>
                <Storyboard x:Key="SuccessOut">
                    <DoubleAnimation Storyboard.TargetName="SuccessOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4" />
                </Storyboard>
            </Grid.Resources>
            <Border Style="{StaticResource PanelCardStyle}" Padding="40,32" HorizontalAlignment="Center" VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <Border.RenderTransform><ScaleTransform x:Name="SuccessScale" /></Border.RenderTransform>
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource PixlinkBlueBrush}" HorizontalAlignment="Center">
                        <FontIcon x:Name="SuccessCheck" Glyph="&#xE73E;" FontSize="34" Foreground="White" Opacity="0" />
                    </Border>
                    <TextBlock Text="You're linked!" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="SuccessText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Not paired: pairing screen fills the window -->
        <Frame x:Name="PairingFrame" Grid.Row="1" Visibility="{x:Bind local:Ui.Collapsed(Session.IsPaired), Mode=OneWay}" />

        <!-- Updating: full-window screen with progress, steps and a bit of motion -->
        <Grid x:Name="UpdatingOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid.Resources>
                <Storyboard x:Key="UpdatingLoop">
                    <DoubleAnimation Storyboard.TargetName="BlobA" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-160" To="160" Duration="0:0:9" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="BlobB" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="120" To="-120" Duration="0:0:11" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleX" From="0.9" To="1.18" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleY" From="0.9" To="1.18" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" From="0.35" To="0.7" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever" />
                    <DoubleAnimation Storyboard.TargetName="UpdateLogoMove" Storyboard.TargetProperty="Y" From="-5" To="5" Duration="0:0:1.8" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="OrbitSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:6" RepeatBehavior="Forever" />
                </Storyboard>
                <Storyboard x:Key="UpdatingIn">
                    <DoubleAnimation Storyboard.TargetName="UpdatingOverlay" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35" />
                    <DoubleAnimation Storyboard.TargetName="UpdatingCardScale" Storyboard.TargetProperty="ScaleX" From="0.85" To="1" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="UpdatingCardScale" Storyboard.TargetProperty="ScaleY" From="0.85" To="1" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>
            <Ellipse x:Name="BlobA" Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-120,-160,0,0">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush><GradientStop Color="#553D7BFF" Offset="0" /><GradientStop Color="#003D7BFF" Offset="1" /></RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="BlobB" Width="560" Height="560" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-100,-140">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush><GradientStop Color="#5532C48D" Offset="0" /><GradientStop Color="#0032C48D" Offset="1" /></RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform><ScaleTransform x:Name="UpdatingCardScale" /></StackPanel.RenderTransform>
                <Grid Width="200" Height="200" HorizontalAlignment="Center">
                    <Ellipse x:Name="Glow" Width="150" Height="150" RenderTransformOrigin="0.5,0.5" Opacity="0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="GlowScale" /></Ellipse.RenderTransform>
                        <Ellipse.Fill>
                            <RadialGradientBrush><GradientStop Color="#AA3D7BFF" Offset="0" /><GradientStop Color="#003D7BFF" Offset="1" /></RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <ProgressRing x:Name="UpdateRing" Width="196" Height="196" IsIndeterminate="False" Maximum="100" Value="0" />
                    <!-- A small dot orbiting the ring -->
                    <Grid Width="196" Height="196" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><RotateTransform x:Name="OrbitSpin" /></Grid.RenderTransform>
                        <Ellipse Width="10" Height="10" Fill="{StaticResource PixlinkBlueBrush}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-14,0,0" />
                    </Grid>
                    <Image Source="Assets/icon-512.png" Width="92" Height="92">
                        <Image.RenderTransform><TranslateTransform x:Name="UpdateLogoMove" /></Image.RenderTransform>
                    </Image>
                </Grid>
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="Updating Tethr Link" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="UpdateVersions" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="UpdatePercent" Text="0%" FontSize="44" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Border x:Name="StepDownload" CornerRadius="16" Padding="14,8"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon x:Name="StepDownloadIcon" Glyph="&#xE896;" FontSize="14" /><TextBlock Text="Download" /></StackPanel></Border>
                    <Border x:Name="StepInstall" CornerRadius="16" Padding="14,8"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon x:Name="StepInstallIcon" Glyph="&#xE912;" FontSize="14" /><TextBlock Text="Install" /></StackPanel></Border>
                    <Border x:Name="StepRestart" CornerRadius="16" Padding="14,8"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon x:Name="StepRestartIcon" Glyph="&#xE777;" FontSize="14" /><TextBlock Text="Restart" /></StackPanel></Border>
                </StackPanel>
                <TextBlock x:Name="UpdateNote" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Tethr Link restarts by itself when it's done. Your phone reconnects automatically." />
                <Button x:Name="UpdateCancel" Content="Hide" HorizontalAlignment="Center" Click="OnHideUpdating" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- What's new: once after every update -->
        <Grid x:Name="WhatsNewOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="{ThemeResource SmokeFillColorDefaultBrush}">
            <Grid.Resources>
                <Storyboard x:Key="WhatsNewIn">
                    <DoubleAnimation Storyboard.TargetName="WhatsNewOverlay" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
                    <DoubleAnimation Storyboard.TargetName="WhatsNewCardScale" Storyboard.TargetProperty="ScaleX" From="0.8" To="1" Duration="0:0:0.55">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="WhatsNewCardScale" Storyboard.TargetProperty="ScaleY" From="0.8" To="1" Duration="0:0:0.55">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="WhatsNewLogoSpin" Storyboard.TargetProperty="Angle" From="-30" To="0" Duration="0:0:0.9">
                        <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="5" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="WhatsNewGlowScale" Storyboard.TargetProperty="ScaleX" From="0.6" To="1.25" Duration="0:0:1.6" RepeatBehavior="Forever" />
                    <DoubleAnimation Storyboard.TargetName="WhatsNewGlowScale" Storyboard.TargetProperty="ScaleY" From="0.6" To="1.25" Duration="0:0:1.6" RepeatBehavior="Forever" />
                    <DoubleAnimation Storyboard.TargetName="WhatsNewGlow" Storyboard.TargetProperty="Opacity" From="0.6" To="0" Duration="0:0:1.6" RepeatBehavior="Forever" />
                </Storyboard>
                <Storyboard x:Key="WhatsNewOut">
                    <DoubleAnimation Storyboard.TargetName="WhatsNewOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                    <DoubleAnimation Storyboard.TargetName="WhatsNewCardScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.3" />
                    <DoubleAnimation Storyboard.TargetName="WhatsNewCardScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.3" />
                </Storyboard>
            </Grid.Resources>
            <Canvas x:Name="ConfettiCanvas" IsHitTestVisible="False" />
            <Border Style="{StaticResource PanelCardStyle}" Width="480" MaxHeight="620" Padding="32,28" HorizontalAlignment="Center" VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <Border.RenderTransform><ScaleTransform x:Name="WhatsNewCardScale" /></Border.RenderTransform>
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Width="120" Height="120" HorizontalAlignment="Center">
                        <Ellipse x:Name="WhatsNewGlow" Width="120" Height="120" Fill="{StaticResource PixlinkBlueBrush}" RenderTransformOrigin="0.5,0.5" Opacity="0">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="WhatsNewGlowScale" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Image Source="Assets/icon-512.png" Width="84" Height="84" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform><RotateTransform x:Name="WhatsNewLogoSpin" /></Image.RenderTransform>
                        </Image>
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="What's new" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="WhatsNewVersion" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="WhatsNewList" Spacing="10" />
                    </ScrollViewer>
                    <Button Grid.Row="3" Content="Continue" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnWhatsNewDone" />
                </Grid>
            </Border>
        </Grid>

        <!-- Splash on start-up -->
        <Grid x:Name="Splash" Grid.RowSpan="2" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid.Resources>
                <Storyboard x:Key="SplashIn">
                    <DoubleAnimation Storyboard.TargetName="SplashLogoScale" Storyboard.TargetProperty="ScaleX" From="0.7" To="1" Duration="0:0:0.6">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="SplashLogoScale" Storyboard.TargetProperty="ScaleY" From="0.7" To="1" Duration="0:0:0.6">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="SplashName" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.25" Duration="0:0:0.4" />
                </Storyboard>
                <Storyboard x:Key="SplashOut">
                    <DoubleAnimation Storyboard.TargetName="Splash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" />
                </Storyboard>
            </Grid.Resources>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                <Image Source="Assets/icon-512.png" Width="112" Height="112" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform><ScaleTransform x:Name="SplashLogoScale" /></Image.RenderTransform>
                </Image>
                <StackPanel x:Name="SplashName" Spacing="10">
                    <TextBlock Text="Tethr Link" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <ProgressRing IsActive="True" Width="22" Height="22" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
