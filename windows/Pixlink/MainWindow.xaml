<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Pixlink.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pixlink"
    xmlns:models="using:Pixlink.Models"
    Title="Pixlink">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="Assets/Pixlink.png" Width="18" Height="18" />
                <TextBlock Text="Pixlink" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <Button Grid.Row="0" HorizontalAlignment="Right" Margin="0,0,148,0" Style="{StaticResource SubtleButtonStyle}"
                Click="OnSettings" ToolTipService.ToolTip="Settings"
                Visibility="{x:Bind local:Ui.Visible(Session.IsPaired), Mode=OneWay}">
            <FontIcon Glyph="&#xE713;" FontSize="16" />
        </Button>

        <!-- Paired layout: phone panel + tabs -->
        <Grid Grid.Row="1" Visibility="{x:Bind local:Ui.Visible(Session.IsPaired), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: phone panel -->
            <Grid Padding="16,4,8,16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Phone header -->
                <Border Style="{StaticResource PanelCardStyle}" Padding="16">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="72" CornerRadius="8" BorderThickness="2"
                                BorderBrush="{ThemeResource TextFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xE8EA;" FontSize="18" Foreground="{StaticResource PixlinkBlueBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{x:Bind Session.PhoneName, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="{x:Bind local:Ui.ConnectedDot(Session.IsConnected), Mode=OneWay}" FontSize="12" />
                                    <TextBlock Text="{x:Bind Session.StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind local:Ui.VisibleIfText(Session.BatteryText), Mode=OneWay}">
                                    <FontIcon Glyph="{x:Bind Session.BatteryGlyph, Mode=OneWay}" FontSize="14" />
                                    <TextBlock Text="{x:Bind Session.BatteryText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Quick actions -->
                <StackPanel Grid.Row="1" Spacing="10">
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <ToggleButton x:Name="HotspotButton" HorizontalAlignment="Stretch" Click="OnHotspot"
                                      IsEnabled="{x:Bind Session.IsConnected, Mode=OneWay}" ToolTipService.ToolTip="Use your phone's internet">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE704;" FontSize="18" />
                                <TextBlock Text="Hotspot" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="OnScreen"
                                IsEnabled="{x:Bind Session.IsConnected, Mode=OneWay}" ToolTipService.ToolTip="Show your phone screen">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE7F4;" FontSize="18" />
                                <TextBlock Text="Screen" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" HorizontalAlignment="Stretch" Click="OnSendFile"
                                IsEnabled="{x:Bind Session.IsConnected, Mode=OneWay}" ToolTipService.ToolTip="Send a file to your phone">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE898;" FontSize="18" />
                                <TextBlock Text="Send file" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="1" HorizontalAlignment="Stretch" Click="OnRing"
                                IsEnabled="{x:Bind Session.IsConnected, Mode=OneWay}" ToolTipService.ToolTip="Ring your phone at full volume, even on silent">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xEA8F;" FontSize="18" />
                                <TextBlock x:Name="RingLabel" Text="Find phone" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnSendClipboard"
                                IsEnabled="{x:Bind Session.IsConnected, Mode=OneWay}" ToolTipService.ToolTip="Send this PC's copied text to your phone's clipboard">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE77F;" FontSize="18" />
                                <TextBlock x:Name="ClipboardLabel" Text="Clipboard" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <ToggleButton Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" Click="OnDnd"
                                      IsChecked="{x:Bind Session.DoNotDisturb, Mode=OneWay}"
                                      IsEnabled="{x:Bind Session.IsConnected, Mode=OneWay}" ToolTipService.ToolTip="Do Not Disturb on your phone">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE708;" FontSize="18" />
                                <TextBlock Text="Silence" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </Grid>

                    <!-- Now playing on the phone -->
                    <Border Style="{StaticResource PanelCardStyle}" Visibility="{x:Bind Session.MediaActive, Mode=OneWay}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource PixlinkBlueBrush}">
                                <FontIcon Glyph="&#xE8D6;" FontSize="18" Foreground="White" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Session.MediaTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{x:Bind Session.MediaArtist, Mode=OneWay}" /><Run Text="  " /><Run Text="{x:Bind Session.MediaApp, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                <Button Style="{StaticResource SubtleButtonStyle}" Click="OnMediaPrevious" ToolTipService.ToolTip="Previous"><FontIcon Glyph="&#xE892;" FontSize="14" /></Button>
                                <Button Style="{StaticResource SubtleButtonStyle}" Click="OnMediaToggle" ToolTipService.ToolTip="Play or pause"><FontIcon Glyph="{x:Bind Session.PlayPauseGlyph, Mode=OneWay}" FontSize="16" /></Button>
                                <Button Style="{StaticResource SubtleButtonStyle}" Click="OnMediaNext" ToolTipService.ToolTip="Next"><FontIcon Glyph="&#xE893;" FontSize="14" /></Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Hotspot progress / result -->
                <InfoBar x:Name="HotspotBar" Grid.Row="2" IsOpen="False" IsClosable="True" Margin="0" />

                <!-- Notifications header -->
                <Grid Grid.Row="3">
                    <TextBlock Text="Notifications" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <HyperlinkButton Content="Clear all" HorizontalAlignment="Right" Click="OnClearAll" />
                </Grid>

                <!-- Notifications list -->
                <ListView Grid.Row="4" ItemsSource="{x:Bind Session.Notifications}" SelectionMode="None" Padding="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Padding" Value="0,0,0,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PhoneNotification">
                            <Border Style="{StaticResource PanelCardStyle}">
                                <Grid ColumnSpacing="10" RowSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Image Source="{x:Bind Icon, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="{x:Bind AppName}" /> · <Run Text="{x:Bind TimeText}" />
                                    </TextBlock>
                                    <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Padding="4" Click="OnDismiss" Tag="{Binding}">
                                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                                    </Button>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind Text}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Right: tabs -->
            <Grid Grid.Column="1" Margin="8,0,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar x:Name="UpdateBar" IsOpen="False" Severity="Informational" Title="Update available" Margin="0,0,0,8">
                    <InfoBar.ActionButton>
                        <Button x:Name="UpdateNowButton" Content="Update now" Click="OnUpdateNow" Style="{StaticResource AccentButtonStyle}" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <SelectorBar x:Name="Tabs" Grid.Row="1" SelectionChanged="OnTabChanged">
                    <SelectorBarItem Text="Messages" Tag="Messages" IsSelected="True">
                        <SelectorBarItem.Icon><FontIcon Glyph="&#xE8BD;" /></SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem Text="Calls" Tag="Calls">
                        <SelectorBarItem.Icon><FontIcon Glyph="&#xE717;" /></SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem Text="Photos" Tag="Photos">
                        <SelectorBarItem.Icon><FontIcon Glyph="&#xEB9F;" /></SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem Text="Files" Tag="Files">
                        <SelectorBarItem.Icon><FontIcon Glyph="&#xE8B7;" /></SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem Text="Screen" Tag="Screen">
                        <SelectorBarItem.Icon><FontIcon Glyph="&#xE7F4;" /></SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>
                <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}" Padding="0" Margin="0,8,0,0">
                    <Frame x:Name="ContentFrame" />
                </Border>
            </Grid>
        </Grid>

        <!-- "You're linked!" moment right after pairing -->
        <Grid x:Name="SuccessOverlay" Grid.Row="1" Visibility="Collapsed" Background="{ThemeResource SmokeFillColorDefaultBrush}">
            <Grid.Resources>
                <Storyboard x:Key="SuccessIn">
                    <DoubleAnimation Storyboard.TargetName="SuccessOverlay" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                    <DoubleAnimation Storyboard.TargetName="SuccessScale" Storyboard.TargetProperty="ScaleX" From="0.6" To="1" Duration="0:0:0.45">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="SuccessScale" Storyboard.TargetProperty="ScaleY" From="0.6" To="1" Duration="0:0:0.45">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="SuccessCheck" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.25" Duration="0:0:0.3" />
                </Storyboard>
                <Storyboard x:Key="SuccessOut">
                    <DoubleAnimation Storyboard.TargetName="SuccessOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4" />
                </Storyboard>
            </Grid.Resources>
            <Border Style="{StaticResource PanelCardStyle}" Padding="40,32" HorizontalAlignment="Center" VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <Border.RenderTransform><ScaleTransform x:Name="SuccessScale" /></Border.RenderTransform>
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource PixlinkBlueBrush}" HorizontalAlignment="Center">
                        <FontIcon x:Name="SuccessCheck" Glyph="&#xE73E;" FontSize="34" Foreground="White" Opacity="0" />
                    </Border>
                    <TextBlock Text="You're linked!" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="SuccessText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Not paired: pairing screen fills the window -->
        <Frame x:Name="PairingFrame" Grid.Row="1" Visibility="{x:Bind local:Ui.Collapsed(Session.IsPaired), Mode=OneWay}" />
    </Grid>
</Window>
