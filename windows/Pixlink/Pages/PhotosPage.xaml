<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pixlink.Pages.PhotosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Pixlink.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="16,12">
            <TextBlock Text="Photos" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="SaveButton" Click="OnSave" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE896;" FontSize="14" />
                        <TextBlock Text="Save to PC" />
                    </StackPanel>
                </Button>
                <Button Click="OnRefresh" ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>
        <GridView x:Name="Grid1" Grid.Row="1" Padding="12,0" SelectionMode="Extended" SelectionChanged="OnSelection"
                  IsItemClickEnabled="False" DoubleTapped="OnOpen" ContainerContentChanging="OnContainerChanging">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:PhotoItem">
                    <Border Width="150" Height="150" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <Image Source="{x:Bind Thumb, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        <ProgressRing x:Name="Loading" Grid.Row="1" IsActive="False" />
        <TextBlock x:Name="StatusText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
