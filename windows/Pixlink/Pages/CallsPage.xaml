<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pixlink.Pages.CallsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Pixlink.Models">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Recents / contacts -->
        <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <SelectorBar x:Name="ListTabs" Margin="8,8,8,0" SelectionChanged="OnListTab">
                <SelectorBarItem Text="Recent" Tag="recent" IsSelected="True" />
                <SelectorBarItem Text="Contacts" Tag="contacts" />
            </SelectorBar>
            <AutoSuggestBox x:Name="Search" Grid.Row="1" Margin="12,8" PlaceholderText="Search contacts"
                            QueryIcon="Find" TextChanged="OnSearch" Visibility="Collapsed" />

            <ListView x:Name="RecentList" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnRecentClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:CallEntry">
                        <Grid ColumnSpacing="12" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Display}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind When}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="PowerModeNote" Grid.Row="2" Margin="20" Spacing="8" Visibility="Collapsed">
                <FontIcon Glyph="&#xE945;" FontSize="28" HorizontalAlignment="Left" />
                <TextBlock Text="Call history needs Power mode" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Open Pixlink on your phone → Power mode to turn it on. You can still call anyone from Contacts or the dial pad." />
            </StackPanel>

            <ListView x:Name="ContactList" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnContactClick" Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Contact">
                        <Grid ColumnSpacing="12" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture DisplayName="{x:Bind Name}" Width="36" Height="36" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind FirstNumber}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Dial pad -->
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Width="280">
            <InfoBar x:Name="BluetoothBar" Severity="Warning" IsClosable="False"
                     Title="Pair over Bluetooth for call audio"
                     Message="To hear calls on this PC, pair your phone in Windows Bluetooth settings.">
                <InfoBar.ActionButton>
                    <Button Content="Open Bluetooth settings" Click="OnOpenBluetooth" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Border x:Name="CallBanner" Style="{StaticResource PanelCardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="CallStateText" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                        <Button x:Name="AnswerButton" Content="Answer" Style="{StaticResource AccentButtonStyle}" Click="OnAnswer" />
                        <Button Content="Hang up" Click="OnHangUp" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBox x:Name="NumberBox" PlaceholderText="Enter a number" FontSize="24" TextAlignment="Center" />
            <Grid x:Name="Pad" RowSpacing="8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
            </Grid>
            <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="44" Click="OnCall">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE717;" FontSize="16" />
                    <TextBlock Text="Call" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
