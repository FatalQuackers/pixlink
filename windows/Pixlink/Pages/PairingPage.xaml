<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pixlink.Pages.PairingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" ColumnSpacing="64" Padding="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="20" VerticalAlignment="Center">
            <TextBlock Text="Link your Pixel to this PC" Style="{StaticResource TitleLargeTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="See notifications, reply to texts, make calls, browse photos and files, and use your phone's screen — right here." />

            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource PixlinkBlueBrush}">
                        <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                    </Border>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330" Text="Install Pixlink on your Pixel from Google Play" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource PixlinkBlueBrush}">
                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                    </Border>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330" Text="Make sure your phone and PC are on the same Wi-Fi" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource PixlinkBlueBrush}">
                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                    </Border>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330" Text="In the app, tap Scan QR code and point it at this screen" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="ExpiryText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="12" HorizontalAlignment="Center">
            <Border Background="White" CornerRadius="12" Padding="20">
                <Image x:Name="QrImage" Width="280" Height="280" />
            </Border>
            <Button Content="Get a new code" HorizontalAlignment="Center" Click="OnRefresh" />
        </StackPanel>
    </Grid>
</Page>
