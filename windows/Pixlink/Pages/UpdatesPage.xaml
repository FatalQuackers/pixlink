<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pixlink.Pages.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Pixlink.Services">

    <Page.Resources>
        <Storyboard x:Key="Spin">
            <DoubleAnimation Storyboard.TargetName="SpinTransform" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.1" RepeatBehavior="Forever" />
        </Storyboard>
        <Storyboard x:Key="Bounce">
            <DoubleAnimation Storyboard.TargetName="BounceTransform" Storyboard.TargetProperty="Y" From="-6" To="6" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="Pop">
            <DoubleAnimation Storyboard.TargetName="PopTransform" Storyboard.TargetProperty="ScaleX" From="0.4" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PopTransform" Storyboard.TargetProperty="ScaleY" From="0.4" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="860" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Style="{StaticResource SubtleButtonStyle}" Click="OnBack" ToolTipService.ToolTip="Back to Settings"><FontIcon Glyph="&#xE72B;" FontSize="14" /></Button>
                <TextBlock Text="Updates" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Status -->
            <Border Style="{StaticResource PanelCardStyle}" Padding="24">
                <Border.Transitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="24" /></TransitionCollection></Border.Transitions>
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid Width="96" Height="96">
                        <Ellipse x:Name="StatusDisc" Fill="{ThemeResource ControlFillColorDefaultBrush}" />
                        <FontIcon x:Name="SpinIcon" Glyph="&#xE895;" FontSize="38" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                            <FontIcon.RenderTransform><RotateTransform x:Name="SpinTransform" /></FontIcon.RenderTransform>
                        </FontIcon>
                        <FontIcon x:Name="ArrowIcon" Glyph="&#xE896;" FontSize="38" Visibility="Collapsed" Foreground="White">
                            <FontIcon.RenderTransform><TranslateTransform x:Name="BounceTransform" /></FontIcon.RenderTransform>
                        </FontIcon>
                        <FontIcon x:Name="CheckIcon" Glyph="&#xE73E;" FontSize="40" Visibility="Collapsed" Foreground="White" RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform><ScaleTransform x:Name="PopTransform" /></FontIcon.RenderTransform>
                        </FontIcon>
                        <FontIcon x:Name="ErrorIcon" Glyph="&#xE783;" FontSize="38" Visibility="Collapsed" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <TextBlock x:Name="StatusTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="StatusDetail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                            <Button x:Name="InstallButton" Style="{StaticResource AccentButtonStyle}" Click="OnInstall" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE896;" FontSize="14" /><TextBlock x:Name="InstallLabel" Text="Install now" /></StackPanel>
                            </Button>
                            <Button x:Name="CheckButton" Click="OnCheck">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="Check for updates" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource PanelCardStyle}" Padding="16,12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Install updates automatically" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Tethr Link checks when it starts and every 6 hours, and never updates during a call or while sharing your screen. Your phone updates itself too." />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnAutoToggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource PanelCardStyle}" Padding="16,12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Get early updates" />
                            <Border CornerRadius="8" Padding="6,1" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                                <TextBlock Text="Early access" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="New versions arrive a day before everyone else. They're tested less, so you might hit a bug first. Turn it on for your phone too in Tethr Link's settings." />
                    </StackPanel>
                    <ToggleSwitch x:Name="EarlySwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnEarlyToggled" />
                </Grid>
            </Border>

            <!-- What's new -->
            <TextBlock Text="What's new" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <ProgressRing x:Name="NotesLoading" IsActive="True" HorizontalAlignment="Left" />
            <TextBlock x:Name="NotesError" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Couldn't load release notes. Check your internet connection." />
            <ItemsControl x:Name="Releases">
                <ItemsControl.ItemContainerTransitions>
                    <TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="32" /></TransitionCollection>
                </ItemsControl.ItemContainerTransitions>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="services:ReleaseInfo">
                        <Border Style="{StaticResource PanelCardStyle}" Padding="20" Margin="0,0,0,12">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="18"><Run Text="Tethr Link " /><Run Text="{x:Bind Version}" /></TextBlock>
                                    <Border CornerRadius="10" Padding="8,2" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Visibility="{x:Bind IsCurrent}">
                                        <TextBlock Text="Installed" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                    <Border CornerRadius="10" Padding="8,2" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" VerticalAlignment="Center" Visibility="{x:Bind IsEarly}">
                                        <TextBlock Text="Early access" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Date}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Notes}" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="22" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
