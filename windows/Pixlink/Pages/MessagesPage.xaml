<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pixlink.Pages.MessagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pixlink"
    xmlns:models="using:Pixlink.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: which view -->
        <Grid Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="Messages" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <SelectorBar x:Name="ViewPicker" HorizontalAlignment="Right" SelectionChanged="OnViewChanged">
                <SelectorBarItem x:Name="PixlinkItem" Text="Chats" Tag="pixlink" ToolTipService.ToolTip="Messages from every app: texts, WhatsApp, Discord, Outlook and more, as they arrive" />
                <SelectorBarItem x:Name="TextsItem" Text="Texts" Tag="texts" ToolTipService.ToolTip="Your SMS history, read straight from your phone. No sign-in needed." />
                <SelectorBarItem x:Name="GoogleItem" Text="Google Messages" Tag="google" ToolTipService.ToolTip="Optional: Google Messages for Web, for RCS history" />
            </SelectorBar>
        </Grid>

        <!-- Recent chats from phone notifications -->
        <Grid x:Name="PixlinkView" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <ListView x:Name="ConversationList" ItemsSource="{x:Bind Session.Conversations}"
                          SelectionChanged="OnConversationSelected" Padding="0,6">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Conversation">
                            <Grid ColumnSpacing="12" Padding="0,10" Background="Transparent">
                                <Grid.ContextFlyout>
                                    <MenuFlyout Opening="OnMenuOpening">
                                        <MenuFlyoutItem Text="Pin to top" Click="OnPin" Tag="{x:Bind}">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE718;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Unpin" Click="OnUnpin" Tag="{x:Bind}">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77A;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Mark as read" Click="OnMarkRead" Tag="{x:Bind}">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C3;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Remove from list" Click="OnRemove" Tag="{x:Bind}">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <PersonPicture DisplayName="{x:Bind Name}" Width="40" Height="40" />
                                    <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Padding="1">
                                        <Image Source="{x:Bind Icon, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind AppName}" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <FontIcon Glyph="&#xE718;" FontSize="11" Visibility="{x:Bind PinVisibility, Mode=OneWay}"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Preview, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind Time, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                    <Button Style="{StaticResource SubtleButtonStyle}" Padding="4" HorizontalAlignment="Right"
                                            Click="OnMore" ToolTipService.ToolTip="More">
                                        <FontIcon Glyph="&#xE712;" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- No chats yet -->
                <StackPanel x:Name="NoChats" VerticalAlignment="Center" Spacing="6" Padding="24">
                    <FontIcon Glyph="&#xE8BD;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="NoChatsTitle" Text="No chats yet" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="NoChatsText" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Messages from any app appear here when they arrive on your phone. For your full text history, open Texts." />
                </StackPanel>
            </Grid>

            <!-- Thread -->
            <Grid Grid.Column="1" x:Name="ThreadView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Padding="20,14" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PersonPicture x:Name="ThreadPicture" Width="32" Height="32" />
                    <TextBlock x:Name="ThreadTitle" Grid.Column="1" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="ThreadMarkRead" Click="OnThreadMarkRead" ToolTipService.ToolTip="Mark as read on your phone">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8C3;" FontSize="14" />
                                <TextBlock Text="Mark as read" />
                            </StackPanel>
                        </Button>
                        <ToggleButton x:Name="ThreadPin" Click="OnThreadPin" ToolTipService.ToolTip="Pin to top">
                            <FontIcon Glyph="&#xE718;" FontSize="14" />
                        </ToggleButton>
                        <Button Click="OnThreadRemove" ToolTipService.ToolTip="Remove from list">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <ListView x:Name="Bubbles" Grid.Row="1" SelectionMode="None" Padding="16,0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ChatBubble">
                            <StackPanel HorizontalAlignment="{x:Bind Align}" Margin="0,4" MaxWidth="460">
                                <TextBlock Text="{x:Bind Sender}" Style="{StaticResource CaptionTextBlockStyle}" Margin="8,0,8,2"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ShowSender}" />
                                <Border CornerRadius="16" Padding="14,10" Background="{x:Bind BubbleBrush}">
                                    <local:LinkTextBlock Text="{x:Bind Text}" />
                                </Border>
                                <TextBlock Text="{x:Bind Time}" Style="{StaticResource CaptionTextBlockStyle}" Margin="8,2"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="{x:Bind Align}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Grid.Row="2" Padding="16" ColumnSpacing="8" x:Name="ReplyRow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ReplyBox" PlaceholderText="Send a message" KeyDown="OnReplyKeyDown" />
                    <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnSend" ToolTipService.ToolTip="Send">
                        <FontIcon Glyph="&#xE724;" FontSize="16" />
                    </Button>
                </Grid>
                <TextBlock x:Name="NoReplyNote" Grid.Row="2" Margin="16" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Text="You can reply here when a new message arrives in this chat. To start a new text, use All texts." />
            </Grid>

            <!-- Nothing selected -->
            <StackPanel Grid.Column="1" x:Name="EmptyView" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="380">
                <FontIcon Glyph="&#xE8BD;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Pick a chat" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Right-click a chat to pin it, mark it as read or remove it. New messages also show under Notifications, where you can expand them and reply." />
            </StackPanel>
        </Grid>

        <!-- All texts: Google Messages for Web, full width -->
        <Grid x:Name="GoogleView" Grid.Row="1" Visibility="Collapsed">
            <WebView2 x:Name="MessagesWeb" />
            <StackPanel x:Name="WebLoading" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <ProgressRing IsActive="True" />
                <TextBlock Text="Opening Google Messages…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
