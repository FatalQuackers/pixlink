<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pixlink.Pages.MessagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pixlink"
    xmlns:models="using:Pixlink.Models">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Conversation list -->
        <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Messages" Style="{StaticResource SubtitleTextBlockStyle}" Margin="16,16,16,8" />
            <ListView x:Name="ConversationList" Grid.Row="1" ItemsSource="{x:Bind Session.Conversations}"
                      SelectionChanged="OnConversationSelected">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Conversation">
                        <Grid ColumnSpacing="12" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture DisplayName="{x:Bind Name}" Width="40" Height="40" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Preview, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind Time, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <HyperlinkButton Grid.Row="2" Margin="12" Click="OnFullHistory"
                             Content="See full history (Google Messages for Web)" />
        </Grid>

        <!-- Thread -->
        <Grid Grid.Column="1" x:Name="ThreadView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" Padding="20,16">
                <PersonPicture x:Name="ThreadPicture" Width="32" Height="32" />
                <TextBlock x:Name="ThreadTitle" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <ListView x:Name="Bubbles" Grid.Row="1" SelectionMode="None" Padding="16,0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatBubble">
                        <StackPanel HorizontalAlignment="{x:Bind Align}" Margin="0,4" MaxWidth="460">
                            <Border CornerRadius="16" Padding="14,10" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </Border>
                            <TextBlock Text="{x:Bind Time}" Style="{StaticResource CaptionTextBlockStyle}" Margin="8,2"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="{x:Bind Align}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid Grid.Row="2" Padding="16" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ReplyBox" PlaceholderText="Send a message" KeyDown="OnReplyKeyDown" />
                <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnSend">
                    <FontIcon Glyph="&#xE724;" FontSize="16" />
                </Button>
            </Grid>
            <TextBlock x:Name="NoReplyNote" Grid.Row="2" Margin="16" Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Text="Reply is available when a new message arrives in this conversation." />
        </Grid>

        <!-- Empty state -->
        <StackPanel Grid.Column="1" x:Name="EmptyView" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="360">
            <FontIcon Glyph="&#xE8BD;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="New texts show up here" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Pixlink shows SMS, RCS and chat messages as they arrive, and you can reply from here." />
        </StackPanel>

        <!-- Full history -->
        <Grid Grid.Column="1" x:Name="WebView" Visibility="Collapsed">
            <WebView2 x:Name="MessagesWeb" />
        </Grid>
    </Grid>
</Page>
