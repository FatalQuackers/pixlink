<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pixlink.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,20,0,4" />
        </Style>
        <Style x:Key="Row" TargetType="Border" BasedOn="{StaticResource PanelCardStyle}">
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="6" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Layout -->
            <TextBlock Text="Layout" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Row}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Quick actions" />
                        <TextBlock x:Name="QuickActionsHint" Style="{StaticResource Hint}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Choose…" Click="OnChooseQuickActions" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Group notifications by app" />
                        <TextBlock Text="Shows each app's notifications together, like a folder" Style="{StaticResource Hint}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="GroupSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnLayoutToggled" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Keep running in the tray when closed" />
                        <TextBlock Text="Closing the window hides Pixlink by the clock so notifications keep coming. Right-click the tray icon to quit." Style="{StaticResource Hint}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="TraySwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnLayoutToggled" />
                </Grid>
            </Border>

            <!-- Connections -->
            <TextBlock Text="Connections" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Row}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Allow Bluetooth connections" />
                        <TextBlock Style="{StaticResource Hint}" Text="Your phone can connect over Bluetooth when there's no shared Wi-Fi. Choose Wi-Fi, Bluetooth or both in the phone's Pixlink settings. Pair the phone with this PC in Windows Bluetooth settings first. Screen sharing needs Wi-Fi." />
                    </StackPanel>
                    <ToggleSwitch x:Name="BluetoothSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnBluetoothToggled" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Let my Pixel find this PC over Bluetooth" />
                        <TextBlock Style="{StaticResource Hint}" Text="Your Pixel can then hide its always-on notification and wake up whenever it's near this PC. Turn on Hide the always-on notification in Pixlink's settings on the phone too. Needs Bluetooth on this PC." />
                        <TextBlock x:Name="PhoneWakeStatus" Style="{StaticResource Hint}" Visibility="Collapsed" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="PhoneWakeSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnPhoneWakeToggled" />
                </Grid>
            </Border>

            <!-- Clipboard -->
            <TextBlock Text="Clipboard" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Row}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Sync clipboard automatically" />
                        <TextBlock Text="Copy on this PC, paste on your phone. To send from the phone, tap &quot;Send clipboard&quot; in Pixlink's notification or its quick settings tile." Style="{StaticResource Hint}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoClipSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnLayoutToggled" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Copy sign-in codes from my phone" />
                        <TextBlock Text="When a verification code arrives on your phone, it's copied here, ready to paste" Style="{StaticResource Hint}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="CodesSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnLayoutToggled" />
                </Grid>
            </Border>

            <!-- Screen -->
            <TextBlock Text="Screen sharing" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Row}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Stop sharing when Pixlink is minimized" />
                        <TextBlock Text="Saves your phone's battery when you're not looking" Style="{StaticResource Hint}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StopHiddenSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnLayoutToggled" />
                </Grid>
            </Border>

            <!-- Help -->
            <TextBlock Text="Help" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Row}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="View logs" Click="OnViewLogs" />
                    <Button Content="Run setup again" Click="OnRunSetup" />
                </StackPanel>
            </Border>

            <!-- General -->
            <TextBlock Text="General" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Row}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="This PC's name" />
                        <TextBlock Text="What your phone shows when pairing" Style="{StaticResource Hint}" />
                    </StackPanel>
                    <TextBox x:Name="PcNameBox" Grid.Column="1" LostFocus="OnPcNameChanged" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                    <TextBlock Text="App theme" VerticalAlignment="Center" />
                    <ComboBox x:Name="ThemeBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnThemeChanged">
                        <ComboBoxItem Content="Use Windows setting" Tag="System" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
                <Grid>
                    <StackPanel Margin="0,0,80,0">
                        <TextBlock Text="Start Pixlink when I sign in to Windows" />
                        <TextBlock Text="So your phone connects without opening the app" Style="{StaticResource Hint}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StartupSwitch" HorizontalAlignment="Right" OnContent="" OffContent="" Toggled="OnToggle" MinWidth="0" />
                </Grid>
            </Border>

            <!-- Notifications -->
            <TextBlock Text="Notifications" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Row}">
                <Grid>
                    <StackPanel Margin="0,0,80,0">
                        <TextBlock Text="Show phone notifications as Windows pop-ups" />
                        <TextBlock Text="Texts get a quick reply box" Style="{StaticResource Hint}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ToastsSwitch" HorizontalAlignment="Right" OnContent="" OffContent="" Toggled="OnToggle" MinWidth="0" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
                <Grid>
                    <StackPanel Margin="0,0,80,0">
                        <TextBlock Text="Show message text in pop-ups" />
                        <TextBlock Text="Turn off to show only who it's from" Style="{StaticResource Hint}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ContentSwitch" HorizontalAlignment="Right" OnContent="" OffContent="" Toggled="OnToggle" MinWidth="0" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
                <Grid>
                    <TextBlock Text="Play a sound for pop-ups" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="SoundSwitch" HorizontalAlignment="Right" OnContent="" OffContent="" Toggled="OnToggle" MinWidth="0" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Pop-ups by app" />
                    <TextBlock Style="{StaticResource Hint}" Text="Apps appear here after they send a notification. Turn one off to stop its pop-ups (it still shows in the list)." />
                    <StackPanel x:Name="AppsList" Spacing="2" />
                </StackPanel>
            </Border>

            <!-- Phone -->
            <TextBlock Text="Phone" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Row}">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Warn me when my phone's battery is low" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="BatterySwitch" HorizontalAlignment="Right" OnContent="" OffContent="" Toggled="OnToggle" MinWidth="0" />
                    </Grid>
                    <Slider x:Name="BatterySlider" Minimum="5" Maximum="50" StepFrequency="5" TickFrequency="5" TickPlacement="BottomRight"
                            Header="Warn at (%)" ValueChanged="OnBatteryLevel" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Row}">
                <Grid>
                    <StackPanel Margin="0,0,110,0">
                        <TextBlock Text="Hotspot details" />
                        <TextBlock x:Name="HotspotText" Style="{StaticResource Hint}" />
                    </StackPanel>
                    <Button Content="Change" HorizontalAlignment="Right" Click="OnChangeHotspot" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
                <Grid>
                    <StackPanel Margin="0,0,80,0">
                        <TextBlock Text="Join the hotspot automatically" />
                        <TextBlock Text="When you turn on Hotspot, connect this PC to it" Style="{StaticResource Hint}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="HotspotSwitch" HorizontalAlignment="Right" OnContent="" OffContent="" Toggled="OnToggle" MinWidth="0" />
                </Grid>
            </Border>

            <!-- Screen -->
            <TextBlock Text="Screen mirroring" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Row}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Quality" />
                            <TextBlock Text="Lower quality is smoother on slow Wi-Fi" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ComboBox x:Name="QualityBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnMirrorChanged">
                            <ComboBoxItem Content="Smooth (720p)" Tag="1280" />
                            <ComboBoxItem Content="Balanced (1080p)" Tag="1920" />
                            <ComboBoxItem Content="Sharp (1600p)" Tag="1600" />
                            <ComboBoxItem Content="Full resolution" Tag="3200" />
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Frame rate" VerticalAlignment="Center" />
                        <ComboBox x:Name="FpsBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnMirrorChanged">
                            <ComboBoxItem Content="30 fps (saves battery)" Tag="30" />
                            <ComboBoxItem Content="60 fps" Tag="60" />
                            <ComboBoxItem Content="90 fps" Tag="90" />
                        </ComboBox>
                    </Grid>
                    <Slider x:Name="BitrateSlider" Minimum="2" Maximum="24" StepFrequency="1" Header="Bitrate (Mbps)" ValueChanged="OnMirrorChanged" />
                </StackPanel>
            </Border>

            <!-- Files -->
            <TextBlock Text="Files" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Row}">
                <Grid>
                    <StackPanel Margin="0,0,140,0">
                        <TextBlock Text="Files from your phone" />
                        <TextBlock x:Name="DownloadText" Style="{StaticResource Hint}" />
                    </StackPanel>
                    <Button Content="Open folder" HorizontalAlignment="Right" Click="OnOpenDownloads" />
                </Grid>
            </Border>

            <!-- Updates -->
            <TextBlock Text="Updates" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Row}">
                <StackPanel Spacing="8">
                    <Grid>
                        <StackPanel Margin="0,0,170,0">
                            <TextBlock x:Name="VersionText" />
                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" Text="Pixlink checks for updates when it starts and every 6 hours." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button x:Name="CheckButton" Content="Check for updates" Click="OnCheckUpdates" />
                            <Button Content="Updates and what's new" Click="OnOpenUpdates" Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <StackPanel Margin="0,0,80,0">
                            <TextBlock Text="Install updates automatically" />
                            <TextBlock Text="New versions install by themselves and Pixlink restarts (never during a call or screen mirroring)" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoUpdateSwitch" HorizontalAlignment="Right" OnContent="" OffContent="" Toggled="OnToggle" MinWidth="0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Security -->
            <TextBlock Text="Privacy and security" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Row}">
                <StackPanel Spacing="4">
                    <TextBlock TextWrapping="Wrap" Text="Everything travels directly between your phone and PC on your network, encrypted with TLS. No cloud, no account." />
                    <TextBlock x:Name="FingerprintText" Style="{StaticResource Hint}" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Row}">
                <Grid>
                    <StackPanel Margin="0,0,130,0">
                        <TextBlock x:Name="PhoneText" />
                        <TextBlock Text="Unlink to pair a different phone" Style="{StaticResource Hint}" />
                    </StackPanel>
                    <Button Content="Unlink phone" HorizontalAlignment="Right" Click="OnUnpair" />
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,20,0,0">
                <HyperlinkButton Content="Pixlink on GitHub" NavigateUri="https://github.com/FatalQuackers/pixlink" />
                <HyperlinkButton Content="Report a problem" NavigateUri="https://github.com/FatalQuackers/pixlink/issues" />
                <HyperlinkButton Content="Open crash log folder" Click="OnOpenLogs" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Text="Open source (MIT). Not affiliated with Google or Microsoft." />
        </StackPanel>
    </ScrollViewer>
</Page>
