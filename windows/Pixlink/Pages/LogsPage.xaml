<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pixlink.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Pixlink.Services">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Style="{StaticResource SubtleButtonStyle}" Click="OnBack" ToolTipService.ToolTip="Back to Settings"><FontIcon Glyph="&#xE72B;" FontSize="14" /></Button>
            <TextBlock Text="Logs" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Copy all" Click="OnCopy" />
            <Button Content="Open log folder" Click="OnOpenFolder" />
            <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="What Pixlink did, newest first. No message contents are logged." />
        </StackPanel>
        <ListView Grid.Row="2" ItemsSource="{x:Bind Entries}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="services:Log+Entry">
                    <Grid ColumnSpacing="12" Padding="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="50" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind TimeText}" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Level}" FontFamily="Consolas" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
