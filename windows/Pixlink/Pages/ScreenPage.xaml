<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pixlink.Pages.ScreenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The phone screen -->
        <Border x:Name="PhoneFrame" CornerRadius="24" BorderThickness="6" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                Background="Black" HorizontalAlignment="Center" Visibility="Collapsed">
            <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="False" Stretch="Uniform" IsTabStop="True"
                                PointerPressed="OnPointerPressed" PointerMoved="OnPointerMoved" PointerReleased="OnPointerReleased"
                                PointerWheelChanged="OnWheel" KeyDown="OnKeyDown" CharacterReceived="OnChar" />
        </Border>

        <!-- Start / waiting -->
        <StackPanel x:Name="StartPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="380">
            <FontIcon Glyph="&#xE7F4;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Use your phone's screen on your PC" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="StartHint" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Your phone will ask you to confirm each time — that's an Android rule." />
            <Button x:Name="StartButton" Content="Start" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="OnStart" />
            <ProgressRing x:Name="Waiting" IsActive="False" />
        </StackPanel>

        <!-- Controls -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,12,0,0" x:Name="Controls" Visibility="Collapsed">
            <Button ToolTipService.ToolTip="Back" Click="OnBack"><FontIcon Glyph="&#xE72B;" FontSize="16" /></Button>
            <Button ToolTipService.ToolTip="Home" Click="OnHome"><FontIcon Glyph="&#xE80F;" FontSize="16" /></Button>
            <Button ToolTipService.ToolTip="Recent apps" Click="OnRecents"><FontIcon Glyph="&#xE8A9;" FontSize="16" /></Button>
            <AppBarSeparator />
            <Button Content="Stop" Click="OnStop" />
            <TextBlock x:Name="ControlNote" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="View only — turn on Power mode to control your phone" />
        </StackPanel>
    </Grid>
</Page>
